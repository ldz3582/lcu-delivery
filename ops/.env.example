# ===== 本地依赖服务（docker-compose 读取）=====
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=lcu_delivery
MYSQL_USER=lcu
MYSQL_PASSWORD=lcu123456
MYSQL_PORT=3306
REDIS_PASSWORD=redis123456
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Spring Boot 数据源 =====
DB_URL=jdbc:mysql://127.0.0.1:3306/lcu_delivery?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=lcu
DB_PASSWORD=lcu123456
REDIS_HOST=127.0.0.1

# ===== 应用 =====
JWT_SECRET=replace_with_at_least_32_chars_random_string
# 敏感字段（学号/身份证/手机号）AES-GCM 密钥，生产必须覆盖
APP_CRYPTO_KEY=replace_with_32_chars_random_string

# ===== 微信小程序登录 =====
# 留空 -> 走 mock 登录；填了 -> 走真实 code2session
# 一键接入：./ops/use-wechat.sh <AppID> <AppSecret>
WX_USER_APPID=
WX_USER_SECRET=

# 平台开关（身份核验 / 地址解析 / 配送费 / 佣金 等）在 sys_config 表里改，
# 后台「平台配置」页可视化编辑，不要写进 .env。

# ---------------------------------------------------------------
# 以下为「二期/待接入」预留项：当前代码未读取，接真实第三方时再填。
# ---------------------------------------------------------------
# 微信支付（APIv3）：接商户号后由 WechatPayGateway 使用
# WXPAY_MCH_ID=
# WXPAY_MCH_SERIAL_NO=
# WXPAY_API_V3_KEY=
# WXPAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# WXPAY_NOTIFY_URL=https://api.your-domain.com/api/pay/notify
#
# 腾讯位置服务（围栏选点 / 地址解析），当前用本地正则 + uni.openLocation
# TENCENT_MAP_KEY=
#
# 对象存储，当前落本地 server/uploads
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_PUBLIC_BASE=
