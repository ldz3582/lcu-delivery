# 部署环境变量模板（仓库里只有占位符，真值在服务器上）
# 生成：cp .env.example .env && sh gen-secrets.sh（或手工改）

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DATABASE=lcu_delivery
MYSQL_USER=lcu
MYSQL_PASSWORD=CHANGE_ME_lcu

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_redis

# ---------- 后端安全密钥（生产必须换掉默认值） ----------
# JWT 签名密钥：>=32 字节随机串
JWT_SECRET=CHANGE_ME_jwt_32bytes_min
# 学号/身份证/手机号 AES-GCM 加密密钥：必须 32 字节，换过之后老数据解不开，首次部署就要定好
APP_CRYPTO_KEY=CHANGE_ME_32_bytes_crypto_key_____!

# ---------- 后台初始账号 ----------
# 只在 admin_user 表为空（首次启动）时生效；之后改密码请用后台「账号管理」
ADMIN_INIT_PASSWORD=CHANGE_ME_admin_password

# ---------- 业务开关 ----------# 演示阶段保持 true：无微信商户号也能跑通登录/支付/退款链路
# 接入真实微信后：APP_MOCK_LOGIN=false、APP_MOCK_PAY=false、并填下面的 AppID/Secret
APP_MOCK_LOGIN=true
APP_MOCK_PAY=true
APP_FENCE_ENFORCE=true

# 图片对外地址前缀。留空 = 按请求 Host 自动拼（用 IP 访问时最省事）
# 有域名后改成 https://api.example.com
APP_PUBLIC_BASE_URL=

# ---------- 微信（可选） ----------
WX_USER_APPID=
WX_USER_SECRET=
TENCENT_MAP_KEY=
