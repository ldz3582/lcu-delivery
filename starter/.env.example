# ===== 本地依赖服务 =====
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=lcu_delivery
MYSQL_USER=lcu
MYSQL_PASSWORD=lcu123456
MYSQL_PORT=3306
REDIS_PASSWORD=redis123456
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Spring Boot 数据源 =====
DB_URL=jdbc:mysql://127.0.0.1:3306/lcu_delivery?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=lcu
DB_PASSWORD=lcu123456
REDIS_HOST=127.0.0.1
REDIS_PORT_NO=6379
REDIS_PASSWORD_ENV=redis123456

# ===== 微信小程序（用户端）=====
WX_USER_APPID=wx0000000000000000
WX_USER_SECRET=replace_me
# ===== 微信小程序（商家/骑手工作台）=====
WX_WORK_APPID=wx0000000000000000
WX_WORK_SECRET=replace_me

# ===== 微信支付（APIv3）=====
WXPAY_MCH_ID=1900000000
WXPAY_MCH_SERIAL_NO=REPLACE_WITH_CERT_SERIAL
WXPAY_API_V3_KEY=32_chars_api_v3_key_replace_me_
WXPAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WXPAY_PLATFORM_CERT_PATH=./certs/wechatpay_platform_cert.pem
WXPAY_NOTIFY_URL=https://api.your-domain.com/api/pay/notify
# 分账接收方添加时需要，和商户号绑定的 AppID
WXPAY_APPID=wx0000000000000000

# ===== 腾讯位置服务（围栏/地址解析）=====
TENCENT_MAP_KEY=replace_me

# ===== 对象存储（本地用 MinIO，生产换 COS/OSS）=====
OSS_ENDPOINT=http://127.0.0.1:9000
OSS_BUCKET=lcu-delivery
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin123
OSS_PUBLIC_BASE=http://127.0.0.1:9000/lcu-delivery

# ===== 应用 =====
APP_ENV=dev
JWT_SECRET=replace_with_at_least_32_chars_random_string
# 后台开关默认值（真实值请在 sys_config 表里改，不要写死在代码里）
FEATURE_IDENTITY_CHECK=false
FEATURE_ADDRESS_PARSE=true
